generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderBooker {
  id              String           @id @default(cuid())
  name            String           @unique
  phone           String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  entries         DailyEntry[]
  balances        BalanceHistory[]
  openingCredits  OpeningCredit[]
  salesTargets    SalesTarget[]
}

model Company {
  id              String           @id @default(cuid())
  name            String           @unique
  category        String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  entries         DailyEntry[]
  balances        BalanceHistory[]
  openingCredits  OpeningCredit[]
  salesTargets    SalesTarget[]
}

model DailyEntry {
  id                    String   @id @default(cuid())
  date                  DateTime
  orderBookerId         String
  companyId             String
  openingBalance        Float    @default(0)
  summaryAmount         Float    @default(0)
  stockReturn           Float    @default(0)
  postedSummary         Float    @default(0)
  cashReceived          Float    @default(0)
  creditPosted          Float    @default(0)
  claimCleared          Float    @default(0)
  oldRecovery           Float    @default(0)
  returnStockClaimByOB  Float    @default(0)
  totalRecovery         Float    @default(0)
  closingBalance        Float    @default(0)
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  orderBooker OrderBooker @relation(fields: [orderBookerId], references: [id])
  company     Company     @relation(fields: [companyId], references: [id])

  @@unique([date, orderBookerId, companyId])
}

model BalanceHistory {
  id              String   @id @default(cuid())
  date            DateTime
  orderBookerId   String
  companyId       String
  closingBalance  Float    @default(0)
  createdAt       DateTime @default(now())

  orderBooker OrderBooker @relation(fields: [orderBookerId], references: [id])
  company     Company     @relation(fields: [companyId], references: [id])

  @@unique([date, orderBookerId, companyId])
}

model OpeningCredit {
  id              String   @id @default(cuid())
  orderBookerId   String
  companyId       String
  amount          Float    @default(0)
  date            DateTime
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orderBooker OrderBooker @relation(fields: [orderBookerId], references: [id])
  company     Company     @relation(fields: [companyId], references: [id])

  @@unique([orderBookerId, companyId, date])
}

model SalesTarget {
  id              String   @id @default(cuid())
  orderBookerId   String
  companyId       String
  month           Int
  year            Int
  targetCtns      Float    @default(0)
  targetTonnage   Float    @default(0)
  targetValue     Float    @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orderBooker OrderBooker @relation(fields: [orderBookerId], references: [id])
  company     Company     @relation(fields: [companyId], references: [id])

  @@unique([orderBookerId, companyId, month, year])
}
